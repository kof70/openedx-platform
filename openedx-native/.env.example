# Open edX Native Docker Compose - Environment Configuration
# Copy this file to .env and replace placeholder values with actual secrets

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=production  # or development

# ============================================================================
# MYSQL DATABASE CONFIGURATION
# ============================================================================
# Generate strong password: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
MYSQL_DATABASE=openedx
MYSQL_USER=openedx
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# ============================================================================
# MONGODB CONFIGURATION
# ============================================================================
MONGO_DATABASE=openedx
MONGO_USER=openedx
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis password (optional but recommended for production)
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# ============================================================================
# MEILISEARCH CONFIGURATION
# ============================================================================
# Generate master key: openssl rand -base64 32
MEILI_MASTER_KEY=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# ============================================================================
# DJANGO CONFIGURATION
# ============================================================================
# Generate Django secret key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY_50_CHARS

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=lms.example.com,studio.example.com,localhost

# ============================================================================
# PLATFORM URLS
# ============================================================================
LMS_ROOT_URL=https://lms.example.com
CMS_ROOT_URL=https://studio.example.com
LMS_HOST=lms.example.com
CMS_HOST=studio.example.com

# ============================================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=admin@example.com

# ============================================================================
# LOCALIZATION
# ============================================================================
LANGUAGE_CODE=fr
TIME_ZONE=Europe/Paris

# ============================================================================
# FEATURE FLAGS (MVP)
# ============================================================================
# MVP features enabled
ENABLE_CERTIFICATES=true
ENABLE_COHORTS=true
ENABLE_BULK_EMAIL=true
ENABLE_INSTRUCTOR_EMAIL=true
ENABLE_GRADE_DOWNLOADS=true
ENABLE_STUDENT_NOTES=true
ENABLE_PREREQUISITE_COURSES=true
ENABLE_ENTRANCE_EXAMS=true

# V2 features disabled for MVP
ENABLE_DISCUSSION_SERVICE=false
ENABLE_OAUTH2_PROVIDER=false
ENABLE_THIRD_PARTY_AUTH=false
ENABLE_SCORM=false
ENABLE_XAPI=false
ENABLE_COURSE_DISCOVERY=false
ENABLE_TEAMS=false
ENABLE_WIKI=false

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Set to false in production
DEBUG=false

# Session security
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================
# Database connection pooling (seconds)
CONN_MAX_AGE=600

# Cache timeout (seconds)
CACHE_TIMEOUT=300

# ============================================================================
# CELERY CONFIGURATION
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO  # DEBUG for development, INFO for production

# ============================================================================
# NOTES FOR SECRET GENERATION
# ============================================================================
# Generate strong passwords:
#   openssl rand -base64 32
#
# Generate Django SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# IMPORTANT: Never commit the .env file to version control!
# The .env file is excluded in .gitignore for security.
